{%- set shareUrl = page.url | absUrl(site.url) -%}
<div class="share" data-share-url="{{ shareUrl }}" data-share-title="{{ title }}">
  <span class="share-label">Share this story</span>
  <a class="share-btn wa" href="https://wa.me/?text={{ (title + ' ' + shareUrl) | urlencode }}" target="_blank" rel="noopener">WhatsApp</a>
  <a class="share-btn fb" href="https://www.facebook.com/sharer/sharer.php?u={{ shareUrl | urlencode }}" target="_blank" rel="noopener">Facebook</a>
  <a class="share-btn x" href="https://twitter.com/intent/tweet?text={{ title | urlencode }}&url={{ shareUrl | urlencode }}" target="_blank" rel="noopener">X</a>
  <button class="share-btn copy" type="button" data-copy>Copy Link</button>
</div>
