<article class="latest">
  {% if item.data.image %}<a href="{{ item.url }}"><img src="{{ item.data.image }}" alt="" loading="lazy"></a>{% else %}<span></span>{% endif %}
  <div>
    <div class="mini-kicker">{{ item.data.category }}</div>
    <h3><a href="{{ item.url }}">{{ item.data.title }}</a></h3>
    <time datetime="{{ item.date | isoDate }}">{{ item.date | dateTime }}</time>
  </div>
</article>
