---
layout: base.njk
title: Contact
description: Send The Deccan Times a news tip, correction or advertising enquiry.
permalink: /contact/
---
<div class="section-banner"><span>Write to us</span><h1>Contact</h1><span>{{ site.city }}</span></div>
<main class="layout">
<section class="article">
  <p class="deck">Have a news tip, a correction, or an advertising enquiry? We'd like to hear from you.</p>
  <form class="contact-form" name="contact" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="company">
    <input type="hidden" name="form-name" value="contact">
    <p class="hp"><label>Leave empty <input name="company"></label></p>
    <label>Name<input name="name" required></label>
    <label>Email or phone<input name="contact" required></label>
    <label>Subject
      <select name="subject"><option>News tip</option><option>Correction</option><option>Advertising</option><option>Other</option></select>
    </label>
    <label>Message<textarea name="message" rows="7" required></textarea></label>
    <button type="submit">Send Message →</button>
  </form>
</section>
<aside class="side">
  <div class="side-title">Reach Us</div>
  <p class="contact-line"><strong>Email</strong><br><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
  <p class="contact-line"><strong>Instagram</strong><br><a href="{{ site.instagram }}" target="_blank" rel="noopener">{{ site.instagram | replace("https://www.", "") }}</a></p>
  <p class="contact-line"><strong>Facebook</strong><br><a href="{{ site.facebook }}" target="_blank" rel="noopener">{{ site.facebook | replace("https://www.", "") }}</a></p>
</aside>
</main>
